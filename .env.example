# Destinatário das mensagens enviadas pelo formulário.
CONTACT_EMAIL=contato@suaempresa.com.br

# E-mail verificado no Resend, por exemplo: DOMI Solutions <contato@seudominio.com.br>
EMAIL_FROM="DOMI Solutions <onboarding@resend.dev>"

# Chave criada em https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# SEO: use a URL pública final, com https e sem barra no final.
# Exemplo: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# Google Search Console: cole somente o valor do campo de verificação HTML.
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (opcional, mas recomendado para medir os resultados do SEO).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
